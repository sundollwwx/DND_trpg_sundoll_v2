.sw-root {
    color: #e8e2d8;
    font-size: 13px;
}

.sw-root Button {
    min-height: 32px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    color: #ddd8cf;
    background-color: #242d39;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #394657;
    border-right-color: #394657;
    border-bottom-color: #394657;
    border-left-color: #394657;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.sw-root Button:hover {
    color: #fff8eb;
    background-color: #303b49;
    border-top-color: #c99a52;
    border-right-color: #c99a52;
    border-bottom-color: #c99a52;
    border-left-color: #c99a52;
}

.sw-root TextField {
    min-height: 30px;
    margin-top: 3px;
    color: #e8e2d8;
}

.sw-root .unity-base-text-field__input {
    color: #f2ede4;
    background-color: #111821;
    border-top-color: #354152;
    border-right-color: #354152;
    border-bottom-color: #354152;
    border-left-color: #354152;
}

.sw-topbar {
    background-color: #101721;
    border-bottom-width: 1px;
    border-bottom-color: #2b3645;
}

.sw-brand {
    margin-left: 16px;
    margin-right: 12px;
    color: #f1d7a4;
    font-size: 16px;
    -unity-font-style: bold;
}

.sw-button,
.sw-button-quiet,
.sw-button-accent {
    min-height: 32px;
}

.sw-side-panel {
    background-color: #151d27;
    border-right-width: 1px;
    border-right-color: #2c3746;
}

.sw-tabbar {
    height: 42px;
    min-height: 42px;
    flex-direction: row;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #313c4a;
}

.sw-root .sw-tab {
    min-width: 0;
    min-height: 32px;
    flex-grow: 1;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 4px;
    padding-right: 4px;
    color: #9ea8b4;
    background-color: #18212b;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-bottom-color: #18212b;
}

.sw-root .sw-tab-selected {
    color: #f3dfb7;
    background-color: #222c38;
    border-bottom-color: #c99a52;
}

.sw-workspace-section {
    flex-grow: 1;
    min-height: 0;
}

.sw-material-palette {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.sw-root .sw-material-button {
    width: 106px;
    min-height: 38px;
    margin-right: 4px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    white-space: normal;
}

.sw-piece-grid {
    min-height: 220px;
    background-color: #111821;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #2d3947;
    border-right-color: #2d3947;
    border-bottom-color: #2d3947;
    border-left-color: #2d3947;
}

.sw-piece-library-section {
    margin-top: 10px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 9px;
    padding-bottom: 10px;
    background-color: rgba(24, 33, 44, 0.72);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #2f3d4d;
    border-right-color: #2f3d4d;
    border-bottom-color: #2f3d4d;
    border-left-color: #2f3d4d;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.sw-piece-library-section .sw-section-title {
    margin-bottom: 6px;
    color: #e3c17d;
    font-size: 13px;
}

.sw-piece-library-section .sw-muted {
    margin-bottom: 3px;
    font-size: 11px;
}

.sw-host-tool-section {
    margin-top: 10px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 9px;
    padding-bottom: 10px;
    background-color: rgba(24, 33, 44, 0.72);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #2f3d4d;
    border-right-color: #2f3d4d;
    border-bottom-color: #2f3d4d;
    border-left-color: #2f3d4d;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.sw-host-tool-section .sw-section-title {
    margin-bottom: 6px;
    color: #e3c17d;
    font-size: 13px;
}

.sw-host-tool-section .sw-muted {
    margin-bottom: 3px;
    font-size: 11px;
}

.sw-inspector-title {
    min-height: 28px;
    color: #f1d7a4;
    font-size: 15px;
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: #4a3d2b;
}

.sw-root .unity-foldout__toggle {
    color: #c8bda9;
}

#InspectorDiagnosticsBody {
    margin-top: 4px;
    color: #9fa9b5;
    white-space: normal;
}

.sw-piece-grid-row {
    height: 116px;
    min-height: 116px;
    flex-direction: row;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.sw-root .sw-piece-card {
    min-width: 0;
    min-height: 108px;
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 4px;
    background-color: #1a2430;
    border-top-color: #334253;
    border-right-color: #334253;
    border-bottom-color: #334253;
    border-left-color: #334253;
}

.sw-root .sw-piece-card-selected {
    background-color: #293342;
    border-top-color: #c99a52;
    border-right-color: #c99a52;
    border-bottom-color: #c99a52;
    border-left-color: #c99a52;
}

.sw-piece-card-image {
    width: 54px;
    height: 54px;
    align-self: center;
    background-color: #0e141c;
}

.sw-piece-card-title {
    height: 28px;
    margin-top: 2px;
    color: #ece7db;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.sw-piece-card-status {
    height: 16px;
    color: #8f9dac;
    font-size: 9px;
    -unity-text-align: middle-center;
    overflow: hidden;
}

.sw-button-quiet {
    background-color: #18212c;
    border-top-color: #2f3a48;
    border-right-color: #2f3a48;
    border-bottom-color: #2f3a48;
    border-left-color: #2f3a48;
}

.sw-button-accent {
    color: #15191e;
    background-color: #c99a52;
    border-top-color: #e3ba78;
    border-right-color: #e3ba78;
    border-bottom-color: #e3ba78;
    border-left-color: #e3ba78;
    -unity-font-style: bold;
}

.sw-title {
    color: #f1d7a4;
    font-size: 22px;
    -unity-font-style: bold;
}

.sw-section-title {
    margin-top: 14px;
    margin-bottom: 5px;
    color: #dcb879;
    font-size: 14px;
    -unity-font-style: bold;
}

.sw-muted {
    color: #919cab;
    white-space: normal;
}

.sw-error {
    color: #f19a96;
}

.sw-project-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 12, 0.88);
}

.sw-project-card {
    width: 920px;
    max-width: 92%;
    height: 680px;
    max-height: 90%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 18px;
    background-color: #171f2a;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #8c6a3b;
    border-right-color: #8c6a3b;
    border-bottom-color: #8c6a3b;
    border-left-color: #8c6a3b;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.sw-project-header {
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sw-project-current {
    margin-top: 8px;
    margin-bottom: 8px;
    color: #b8c3cf;
}

.sw-project-columns {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.sw-project-column {
    flex-grow: 1;
    width: 50%;
    min-width: 0;
    margin-right: 12px;
    padding-right: 8px;
}

.sw-project-recent {
    flex-grow: 1;
    min-height: 0;
}

.sw-recent-item {
    min-height: 52px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.sw-project-status {
    min-height: 36px;
    margin-top: 10px;
    padding-top: 8px;
    color: #aeb8c4;
    white-space: normal;
    border-top-width: 1px;
    border-top-color: #303b49;
}

.sw-workspace-navigation {
    flex-direction: row;
    align-items: center;
    margin-left: 18px;
    min-width: 300px;
}

.sw-workspace-button {
    min-width: 92px;
    min-height: 34px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 12px;
    padding-right: 12px;
    color: #aeb8c4;
    background-color: #18212c;
    border-top-color: #2d3a4a;
    border-right-color: #2d3a4a;
    border-bottom-color: #2d3a4a;
    border-left-color: #2d3a4a;
}

.sw-workspace-button-selected {
    color: #fff2d2;
    background-color: #76552e;
    border-top-color: #e0b66f;
    border-right-color: #e0b66f;
    border-bottom-color: #e0b66f;
    border-left-color: #e0b66f;
    -unity-font-style: bold;
}

.sw-primary-workspace {
    background-color: #0d141d;
}

.sw-inspector-body {
    color: #e4d5b7;
    white-space: normal;
}

#MapEditorTools,
#PieceLibraryTools,
#HostConsoleTools,
#HostHierarchyPanel,
#PieceLibraryInspector,
#HostConsoleStatus {
    padding-top: 12px;
    padding-bottom: 12px;
}

#MapViewport {
    background-color: #26211a;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #6f5735;
    border-right-color: #6f5735;
    border-bottom-color: #6f5735;
    border-left-color: #6f5735;
}

.sw-map-toolbar {
    min-height: 54px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #151e28;
    border-bottom-width: 1px;
    border-bottom-color: #39485a;
}

.sw-map-toolbar-title {
    min-width: 74px;
    margin-right: 8px;
    color: #f1d7a4;
    font-size: 14px;
    -unity-font-style: bold;
}

.sw-map-tool-button {
    min-width: 58px;
    min-height: 34px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 6px;
    padding-right: 6px;
}

.sw-root .sw-map-tool-selected {
    color: #fff4da;
    background-color: #73552a;
    border-top-color: #f0c777;
    border-right-color: #f0c777;
    border-bottom-color: #f0c777;
    border-left-color: #f0c777;
    -unity-font-style: bold;
}

.sw-root .sw-layer-selected {
    color: #fff4da;
    background-color: #324052;
    border-left-width: 3px;
    border-left-color: #d7a85b;
}

.sw-root .sw-layer-state-active {
    color: #f3dfb7;
    background-color: #3a3023;
}

.sw-map-toolbar-divider {
    width: 1px;
    height: 28px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: #3b4857;
}

#MapEditorWorkspaceBody {
    flex-grow: 1;
    min-height: 0;
}

#MapEditorTools {
    width: 272px;
    min-width: 240px;
}

#MapViewport {
    margin: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #896d45;
    border-right-color: #896d45;
    border-bottom-color: #896d45;
    border-left-color: #896d45;
}

.sw-map-viewport {
    position: relative;
    background-color: #1a1713;
}

.sw-boundary-feedback {
    position: absolute;
    right: 12px;
    top: 12px;
    min-height: 28px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: #f4e3c1;
    background-color: rgba(58, 45, 29, 0.92);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #98784a;
    border-right-color: #98784a;
    border-bottom-color: #98784a;
    border-left-color: #98784a;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.sw-boundary-ok {
    color: #f4e3c1;
}

.sw-boundary-warning {
    color: #fff1ed;
    background-color: rgba(121, 42, 37, 0.96);
    border-top-color: #f07d68;
    border-right-color: #f07d68;
    border-bottom-color: #f07d68;
    border-left-color: #f07d68;
    -unity-font-style: bold;
}

.sw-material-button {
    flex-direction: row;
    align-items: center;
}

.sw-root .sw-material-selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #f0c777;
    border-right-color: #f0c777;
    border-bottom-color: #f0c777;
    border-left-color: #f0c777;
}

.sw-material-thumbnail {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 6px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.38);
    border-right-color: rgba(255, 255, 255, 0.38);
    border-bottom-color: rgba(0, 0, 0, 0.24);
    border-left-color: rgba(255, 255, 255, 0.38);
}

.sw-material-label {
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-left;
}

.sw-workspace-section {
    padding-top: 6px;
}
