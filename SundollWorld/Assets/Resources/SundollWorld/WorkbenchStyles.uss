.sw-root {
    color: #e8e2d8;
    font-size: 13px;
}

.sw-root Button {
    min-height: 32px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    color: #ddd8cf;
    background-color: #242d39;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #394657;
    border-right-color: #394657;
    border-bottom-color: #394657;
    border-left-color: #394657;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.sw-root Button:hover {
    color: #fff8eb;
    background-color: #303b49;
    border-top-color: #c99a52;
    border-right-color: #c99a52;
    border-bottom-color: #c99a52;
    border-left-color: #c99a52;
}

.sw-root TextField {
    min-height: 30px;
    margin-top: 3px;
    color: #e8e2d8;
}

.sw-root .unity-base-text-field__input {
    color: #f2ede4;
    background-color: #111821;
    border-top-color: #354152;
    border-right-color: #354152;
    border-bottom-color: #354152;
    border-left-color: #354152;
}

.sw-topbar {
    background-color: #101721;
    border-bottom-width: 1px;
    border-bottom-color: #2b3645;
}

.sw-brand {
    margin-left: 16px;
    margin-right: 12px;
    color: #f1d7a4;
    font-size: 16px;
    -unity-font-style: bold;
}

.sw-button,
.sw-button-quiet,
.sw-button-accent {
    min-height: 32px;
}

.sw-button-quiet {
    background-color: #18212c;
    border-top-color: #2f3a48;
    border-right-color: #2f3a48;
    border-bottom-color: #2f3a48;
    border-left-color: #2f3a48;
}

.sw-button-accent {
    color: #15191e;
    background-color: #c99a52;
    border-top-color: #e3ba78;
    border-right-color: #e3ba78;
    border-bottom-color: #e3ba78;
    border-left-color: #e3ba78;
    -unity-font-style: bold;
}

.sw-title {
    color: #f1d7a4;
    font-size: 22px;
    -unity-font-style: bold;
}

.sw-section-title {
    margin-top: 14px;
    margin-bottom: 5px;
    color: #dcb879;
    font-size: 14px;
    -unity-font-style: bold;
}

.sw-muted {
    color: #919cab;
    white-space: normal;
}

.sw-error {
    color: #f19a96;
}

.sw-project-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 12, 0.88);
}

.sw-project-card {
    width: 920px;
    max-width: 92%;
    height: 680px;
    max-height: 90%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 18px;
    background-color: #171f2a;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #8c6a3b;
    border-right-color: #8c6a3b;
    border-bottom-color: #8c6a3b;
    border-left-color: #8c6a3b;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.sw-project-header {
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sw-project-current {
    margin-top: 8px;
    margin-bottom: 8px;
    color: #b8c3cf;
}

.sw-project-columns {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.sw-project-column {
    flex-grow: 1;
    width: 50%;
    min-width: 0;
    margin-right: 12px;
    padding-right: 8px;
}

.sw-project-recent {
    flex-grow: 1;
    min-height: 0;
}

.sw-recent-item {
    min-height: 52px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.sw-project-status {
    min-height: 36px;
    margin-top: 10px;
    padding-top: 8px;
    color: #aeb8c4;
    white-space: normal;
    border-top-width: 1px;
    border-top-color: #303b49;
}
