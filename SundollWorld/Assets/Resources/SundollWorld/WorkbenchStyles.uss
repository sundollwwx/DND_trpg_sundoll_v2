.sw-root {
    color: rgb(232, 235, 240);
    font-size: 14px;
}

.sw-topbar {
    background-color: rgb(20, 29, 44);
    border-bottom-width: 1px;
    border-bottom-color: rgb(58, 72, 94);
    padding-left: 14px;
    padding-right: 10px;
}

.sw-brand {
    color: rgb(246, 203, 116);
    font-size: 16px;
    -unity-font-style: bold;
}

.sw-workspace-navigation {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin-left: 18px;
}

.sw-workspace-button,
.sw-tab {
    min-height: 32px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(205, 214, 226);
    background-color: rgb(34, 46, 66);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(65, 82, 108);
    border-right-color: rgb(65, 82, 108);
    border-top-color: rgb(65, 82, 108);
    border-bottom-color: rgb(65, 82, 108);
}

.sw-workspace-button:hover,
.sw-tab:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(50, 66, 91);
}

.sw-workspace-button:focus,
.sw-tab:focus {
    border-left-color: rgb(246, 203, 116);
    border-right-color: rgb(246, 203, 116);
    border-top-color: rgb(246, 203, 116);
    border-bottom-color: rgb(246, 203, 116);
}

.sw-workspace-button-selected,
.sw-tab-selected {
    color: rgb(25, 32, 44);
    background-color: rgb(246, 203, 116);
    -unity-font-style: bold;
}

.sw-primary-workspace {
    flex-grow: 1;
    min-height: 0;
    background-color: rgb(27, 35, 49);
}

.sw-side-panel {
    background-color: rgb(25, 33, 47);
    border-right-width: 1px;
    border-right-color: rgb(56, 69, 90);
    padding-top: 12px;
    padding-bottom: 10px;
}

.sw-workspace-section {
    padding-bottom: 12px;
}

.sw-map-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 48px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgb(30, 40, 57);
    border-bottom-width: 1px;
    border-bottom-color: rgb(61, 74, 96);
}

.sw-map-toolbar-title {
    margin-right: 14px;
    color: rgb(246, 203, 116);
    -unity-font-style: bold;
}

.sw-map-tool-button {
    min-height: 30px;
    margin-left: 3px;
    margin-right: 3px;
    color: rgb(208, 216, 228);
    background-color: rgb(45, 59, 81);
}

.sw-map-tool-button:hover {
    background-color: rgb(61, 79, 105);
}

.sw-map-tool-selected {
    color: rgb(32, 37, 45);
    background-color: rgb(246, 203, 116);
    -unity-font-style: bold;
}

.sw-map-viewport {
    background-color: rgb(67, 61, 54);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgb(91, 84, 74);
    border-right-color: rgb(91, 84, 74);
}

.sw-inspector-title,
.sw-section-title,
.sw-title {
    color: rgb(246, 203, 116);
    -unity-font-style: bold;
}

.sw-inspector-body {
    color: rgb(227, 231, 236);
    padding-top: 4px;
    padding-bottom: 4px;
}

.sw-muted {
    color: rgb(163, 174, 190);
}

.sw-piece-library-section,
.sw-host-tool-section {
    margin-top: 10px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(31, 41, 58);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(56, 70, 92);
    border-bottom-color: rgb(56, 70, 92);
}

.sw-material-palette,
.sw-piece-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.sw-material-button {
    min-width: 92px;
    min-height: 52px;
    margin-top: 4px;
    margin-right: 5px;
    padding-left: 5px;
    padding-right: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(102, 112, 126);
    border-right-color: rgb(102, 112, 126);
    border-top-color: rgb(102, 112, 126);
    border-bottom-color: rgb(102, 112, 126);
}

.sw-material-selected {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(246, 203, 116);
    border-right-color: rgb(246, 203, 116);
    border-top-color: rgb(246, 203, 116);
    border-bottom-color: rgb(246, 203, 116);
}

.sw-material-thumbnail {
    min-height: 24px;
    margin-bottom: 4px;
}

.sw-material-label {
    -unity-text-align: middle-center;
}

.sw-boundary-feedback {
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: rgb(54, 43, 27);
    background-color: rgba(246, 203, 116, 0.9);
    -unity-font-style: bold;
}

.sw-boundary-warning {
    color: rgb(255, 239, 226);
    background-color: rgba(176, 69, 49, 0.95);
}

.sw-button-accent {
    color: rgb(35, 39, 45);
    background-color: rgb(246, 203, 116);
}

.sw-button-accent:hover {
    background-color: rgb(255, 220, 145);
}

.sw-root Button,
.sw-root TextField,
.sw-root DropdownField,
.sw-root Toggle {
    margin-top: 3px;
}

.sw-root Button:focus,
.sw-root TextField:focus,
.sw-root DropdownField:focus,
.sw-root Toggle:focus {
    border-left-color: rgb(246, 203, 116);
    border-right-color: rgb(246, 203, 116);
    border-top-color: rgb(246, 203, 116);
    border-bottom-color: rgb(246, 203, 116);
}

.sw-project-overlay {
    background-color: rgba(12, 17, 26, 0.96);
}

/* UX7 compatibility: dynamically-built diagnostic and workspace panels still
 * use the original selectors below. Keep these rules in the shared sheet so
 * visual cleanup does not silently remove their layout. */
.sw-root Button {
    min-height: 32px;
    margin-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    color: rgb(221, 225, 232);
    background-color: rgb(36, 45, 57);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(57, 70, 87);
    border-right-color: rgb(57, 70, 87);
    border-bottom-color: rgb(57, 70, 87);
    border-left-color: rgb(57, 70, 87);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.sw-root Button:hover {
    color: rgb(255, 255, 255);
    background-color: rgb(48, 59, 73);
    border-top-color: rgb(201, 154, 82);
    border-right-color: rgb(201, 154, 82);
    border-bottom-color: rgb(201, 154, 82);
    border-left-color: rgb(201, 154, 82);
}

.sw-root TextField {
    min-height: 30px;
    margin-bottom: 3px;
}

.sw-root .unity-base-text-field__input {
    color: rgb(242, 237, 228);
    background-color: rgb(17, 24, 33);
    border-top-color: rgb(53, 65, 82);
    border-right-color: rgb(53, 65, 82);
    border-bottom-color: rgb(53, 65, 82);
    border-left-color: rgb(53, 65, 82);
}

.sw-button,
.sw-button-quiet,
.sw-button-accent {
    min-height: 32px;
}

.sw-button-quiet {
    background-color: rgb(24, 33, 44);
    border-top-color: rgb(47, 58, 72);
    border-right-color: rgb(47, 58, 72);
    border-bottom-color: rgb(47, 58, 72);
    border-left-color: rgb(47, 58, 72);
}

.sw-tabbar {
    height: 42px;
    min-height: 42px;
    flex-direction: row;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(49, 60, 74);
}

.sw-root .sw-tab {
    min-width: 0;
    min-height: 32px;
    flex-grow: 1;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 4px;
    padding-right: 4px;
    color: rgb(158, 168, 180);
    background-color: rgb(24, 33, 43);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-bottom-color: rgb(24, 33, 43);
}

.sw-root .sw-tab-selected {
    color: rgb(243, 223, 183);
    background-color: rgb(34, 44, 56);
    border-bottom-color: rgb(201, 154, 82);
}

.sw-workspace-section {
    flex-grow: 1;
    min-height: 0;
    padding-top: 6px;
}

.sw-piece-grid {
    min-height: 220px;
    background-color: rgb(17, 24, 33);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(45, 57, 71);
    border-right-color: rgb(45, 57, 71);
    border-bottom-color: rgb(45, 57, 71);
    border-left-color: rgb(45, 57, 71);
}

.sw-piece-library-section,
.sw-host-tool-section {
    border-right-width: 1px;
    border-left-width: 1px;
    border-right-color: rgb(56, 70, 92);
    border-left-color: rgb(56, 70, 92);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.sw-piece-library-section .sw-section-title,
.sw-host-tool-section .sw-section-title {
    margin-bottom: 6px;
    font-size: 13px;
}

.sw-piece-library-section .sw-muted,
.sw-host-tool-section .sw-muted {
    margin-bottom: 3px;
    font-size: 11px;
}

.sw-inspector-title {
    min-height: 28px;
    font-size: 15px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(74, 61, 43);
}

.sw-root .unity-foldout__toggle {
    color: rgb(200, 189, 169);
}

#InspectorDiagnosticsBody {
    margin-top: 4px;
    color: rgb(159, 169, 181);
    white-space: normal;
}

.sw-piece-grid-row {
    height: 116px;
    min-height: 116px;
    flex-direction: row;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.sw-root .sw-piece-card {
    min-width: 0;
    min-height: 108px;
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 5px;
    padding-bottom: 4px;
    background-color: rgb(26, 36, 48);
    border-top-color: rgb(51, 66, 83);
    border-right-color: rgb(51, 66, 83);
    border-bottom-color: rgb(51, 66, 83);
    border-left-color: rgb(51, 66, 83);
}

.sw-root .sw-piece-card-selected {
    background-color: rgb(41, 51, 66);
    border-top-color: rgb(201, 154, 82);
    border-right-color: rgb(201, 154, 82);
    border-bottom-color: rgb(201, 154, 82);
    border-left-color: rgb(201, 154, 82);
}

.sw-piece-card-image {
    width: 54px;
    height: 54px;
    align-self: center;
    background-color: rgb(14, 20, 28);
}

.sw-piece-card-title {
    height: 28px;
    margin-top: 2px;
    color: rgb(236, 231, 219);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.sw-piece-card-status {
    height: 16px;
    color: rgb(143, 157, 172);
    font-size: 9px;
    -unity-text-align: middle-center;
    overflow: hidden;
}

.sw-error {
    color: rgb(241, 154, 150);
}

.sw-project-card {
    width: 920px;
    max-width: 92%;
    height: 680px;
    max-height: 90%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 18px;
    background-color: rgb(23, 31, 42);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(140, 106, 59);
    border-right-color: rgb(140, 106, 59);
    border-bottom-color: rgb(140, 106, 59);
    border-left-color: rgb(140, 106, 59);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.sw-project-header {
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sw-project-current {
    margin-top: 8px;
    margin-bottom: 8px;
    color: rgb(184, 195, 207);
}

.sw-project-columns {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.sw-project-column {
    flex-grow: 1;
    width: 50%;
    min-width: 0;
    margin-right: 12px;
    padding-right: 8px;
}

.sw-project-recent {
    flex-grow: 1;
    min-height: 0;
}

.sw-recent-item {
    min-height: 52px;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.sw-project-status {
    min-height: 36px;
    margin-top: 10px;
    padding-top: 8px;
    color: rgb(174, 184, 196);
    white-space: normal;
    border-top-width: 1px;
    border-top-color: rgb(48, 59, 73);
}

.sw-workspace-navigation {
    min-width: 250px;
}

.sw-inspector-body {
    white-space: normal;
}

#MapEditorTools,
#PieceLibraryTools,
#HostConsoleTools,
#HostHierarchyPanel,
#PieceLibraryInspector,
#HostConsoleStatus {
    padding-top: 12px;
    padding-bottom: 12px;
}

#MapViewport {
    margin: 10px;
    background-color: rgb(38, 33, 26);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(137, 109, 69);
    border-right-color: rgb(137, 109, 69);
    border-bottom-color: rgb(137, 109, 69);
    border-left-color: rgb(137, 109, 69);
}

.sw-map-toolbar {
    flex-shrink: 0;
}

.sw-map-toolbar-title {
    min-width: 74px;
    font-size: 14px;
}

.sw-map-tool-button {
    min-width: 58px;
    padding-left: 6px;
    padding-right: 6px;
}

.sw-root .sw-map-tool-selected {
    color: rgb(255, 244, 218);
    background-color: rgb(115, 85, 42);
    border-top-color: rgb(240, 199, 119);
    border-right-color: rgb(240, 199, 119);
    border-bottom-color: rgb(240, 199, 119);
    border-left-color: rgb(240, 199, 119);
    -unity-font-style: bold;
}

.sw-root .sw-layer-selected {
    color: rgb(255, 244, 218);
    background-color: rgb(50, 64, 82);
    border-left-width: 3px;
    border-left-color: rgb(215, 168, 91);
}

.sw-root .sw-layer-state-active {
    color: rgb(243, 223, 183);
    background-color: rgb(58, 48, 35);
}

.sw-map-toolbar-divider {
    width: 1px;
    height: 28px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(59, 72, 87);
}

#MapEditorWorkspaceBody {
    flex-grow: 1;
    min-height: 0;
}

#MapEditorTools {
    width: 272px;
    min-width: 240px;
}

.sw-map-viewport {
    position: relative;
}

.sw-boundary-feedback {
    position: absolute;
    right: 12px;
    top: 12px;
    min-height: 28px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(152, 120, 74);
    border-right-color: rgb(152, 120, 74);
    border-bottom-color: rgb(152, 120, 74);
    border-left-color: rgb(152, 120, 74);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.sw-boundary-ok {
    color: rgb(244, 227, 193);
}

.sw-material-button {
    flex-direction: row;
    align-items: center;
}

.sw-root .sw-material-selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(240, 199, 119);
    border-right-color: rgb(240, 199, 119);
    border-bottom-color: rgb(240, 199, 119);
    border-left-color: rgb(240, 199, 119);
}

.sw-material-thumbnail {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 6px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.38);
    border-right-color: rgba(255, 255, 255, 0.38);
    border-bottom-color: rgba(0, 0, 0, 0.24);
    border-left-color: rgba(255, 255, 255, 0.38);
}

.sw-material-label {
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-left;
}
